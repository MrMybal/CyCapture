{
  "name": "CyCapture",
  "version": "1.5.2",
  "defaultLocale": "en",
  "homePage": "getting-started",
  "locales": [
    { "code": "en", "label": "English" },
    { "code": "fr", "label": "Français" }
  ],
  "content": "manual",
  "assets": "assets",
  "out": "../Documentation",
  "logo": "assets/cycapture-logo.svg",
  "modules": ["image", "gallery"],
  "apiImports": [
    {
      "format": "cydoc",
      "path": "api/plugin-api.en.json",
      "prefix": "cycapture-api",
      "locale": "en"
    }
  ],
  "aliases": {
    "overview": "getting-started",
    "documentation": "getting-started",
    "help": "getting-started",
    "image": "image-annotation",
    "recording": "video",
    "translation": "screen-translation",
    "ocr": "screen-translation#translate-area",
    "folders": "storage",
    "development": "plugin-api#contract",
    "source-sources-plugincontracts-public-cs": "plugin-api#contract",
    "source-sources-captureartifact-public-cs": "plugin-api#capture-model"
  },
  "glossary": {
    "en": {
      "Smart selection": "Selection that follows the visible window, client area or supported control under the pointer.",
      "Tray": "The Windows notification area where CyCapture remains available in the background."
    },
    "fr": {
      "Sélection intelligente": "Sélection qui suit la fenêtre visible, sa zone cliente ou le contrôle compatible sous le pointeur.",
      "Tray": "Zone de notification Windows dans laquelle CyCapture reste disponible en arrière-plan."
    }
  }
}
