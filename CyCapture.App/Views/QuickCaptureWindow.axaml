<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CyCapture.Views.QuickCaptureWindow"
        Title="CyCapture · Capture rapide"
        FontSize="13"
        Width="720" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        Background="Transparent">
  <Border Margin="8" Padding="14" CornerRadius="18" Background="#F20A1010" BorderBrush="#394748" BorderThickness="1">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="4,0,4,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Width="9" Height="9" Fill="#9BFF28" VerticalAlignment="Center" />
          <TextBlock Text="CYCAPTURE" FontWeight="Bold" FontSize="12" LetterSpacing="1.8" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="Choisissez un mode" Foreground="#90A09E" FontSize="11" />
        <Button Grid.Column="2" Content="×" Click="CloseClick" Margin="10,-6,-5,-6" Padding="10,4" Background="Transparent" />
      </Grid>
      <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
        <Button Grid.Column="0" Click="ImageClick" Classes="capture-mode">
          <StackPanel HorizontalAlignment="Center" Spacing="5">
            <TextBlock Text="▣" FontSize="24" Foreground="#9BFF28" HorizontalAlignment="Center" />
            <TextBlock Text="IMAGE" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" />
            <TextBlock Text="Capture instantanée" FontSize="10" Foreground="#90A09E" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Click="VideoClick" Classes="capture-mode">
          <StackPanel HorizontalAlignment="Center" Spacing="5">
            <TextBlock Text="●" FontSize="22" Foreground="#FF4657" HorizontalAlignment="Center" />
            <TextBlock Text="VIDÉO" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" />
            <TextBlock Text="MP4 · son optionnel" FontSize="10" Foreground="#90A09E" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Click="GifClick" Classes="capture-mode">
          <StackPanel HorizontalAlignment="Center" Spacing="5">
            <TextBlock Text="GIF" FontSize="17" FontWeight="Black" Foreground="#6CE5FF" HorizontalAlignment="Center" />
            <TextBlock Text="GIF" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" />
            <TextBlock Text="Animation directe" FontSize="10" Foreground="#90A09E" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Click="AudioClick" Classes="capture-mode">
          <StackPanel HorizontalAlignment="Center" Spacing="5">
            <TextBlock Text="♪" FontSize="24" FontWeight="Black" Foreground="#C58CFF" HorizontalAlignment="Center" />
            <TextBlock Text="AUDIO" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" />
            <TextBlock Text="MP3 · système/micro" FontSize="10" Foreground="#90A09E" />
          </StackPanel>
        </Button>
      </Grid>

      <Border Grid.Row="2" Padding="11" CornerRadius="11" Background="#101717" BorderBrush="#253030" BorderThickness="1">
        <StackPanel Spacing="10">
          <TextBlock Text="RÉGLAGES RAPIDES PAR MODE" FontSize="9" FontWeight="Bold" Foreground="#90A09E" LetterSpacing="1" />
          <TabControl MinHeight="175">
            <TabItem Header="Image" FontSize="14" Foreground="#B4C0BD">
              <Grid Margin="0,8,0,0" ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Spacing="5">
                  <TextBlock Text="FORMAT IMAGE" FontSize="9" FontWeight="Bold" Foreground="#9BFF28" />
                  <ComboBox x:Name="ImageFormatCombo">
                    <ComboBoxItem Content="PNG · sans perte" Tag="png" />
                    <ComboBoxItem Content="JPEG" Tag="jpeg" />
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Text="QUALITÉ JPEG UNIQUEMENT" FontSize="9" FontWeight="Bold" Foreground="#9BFF28" />
                  <ComboBox x:Name="ImageEncodingQualityCombo">
                    <ComboBoxItem Content="40 %" Tag="Compact" />
                    <ComboBoxItem Content="70 %" Tag="Balanced" />
                    <ComboBoxItem Content="90 %" Tag="High" />
                  </ComboBox>
                </StackPanel>
              </Grid>
            </TabItem>
            <TabItem Header="Vidéo" FontSize="14" Foreground="#B4C0BD">
              <StackPanel Margin="0,8,0,0" Spacing="8">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                  <StackPanel Spacing="5">
                    <TextBlock Text="FLUIDITÉ VIDÉO" FontSize="9" FontWeight="Bold" Foreground="#FF6573" />
                    <ComboBox x:Name="VideoQualityCombo">
                      <ComboBoxItem Content="24 images/s" Tag="Compact" />
                      <ComboBoxItem Content="30 images/s" Tag="Balanced" />
                      <ComboBoxItem Content="60 images/s" Tag="High" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Text="DÉBIT VIDÉO" FontSize="9" FontWeight="Bold" Foreground="#FF6573" />
                    <ComboBox x:Name="VideoEncodingQualityCombo">
                      <ComboBoxItem Content="Très faible · 1 Mb/s" Tag="VeryLow" />
                      <ComboBoxItem Content="Compact · 2,5 Mb/s" Tag="Compact" />
                      <ComboBoxItem Content="Équilibré · 6 Mb/s" Tag="Balanced" />
                      <ComboBoxItem Content="Haute · 12 Mb/s" Tag="High" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="5">
                    <TextBlock Text="ENCODAGE DU SON VIDÉO" FontSize="9" FontWeight="Bold" Foreground="#FF6573" />
                    <ComboBox x:Name="AudioEncodingQualityCombo">
                      <ComboBoxItem Content="96 kb/s · mono" Tag="Compact" />
                      <ComboBoxItem Content="128 kb/s · stéréo" Tag="Balanced" />
                      <ComboBoxItem Content="192 kb/s · stéréo" Tag="High" />
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <WrapPanel>
                  <CheckBox x:Name="VideoSystemAudioCheck" Content="Son du système dans la vidéo" Margin="0,0,16,0" />
                  <CheckBox x:Name="VideoMicrophoneCheck" Content="Microphone dans la vidéo" />
                </WrapPanel>
              </StackPanel>
            </TabItem>
            <TabItem Header="GIF" FontSize="14" Foreground="#B4C0BD">
              <StackPanel Margin="0,8,0,0" Spacing="8">
                <TextBlock Text="QUALITÉ GIF · SANS SON" FontSize="9" FontWeight="Bold" Foreground="#6CE5FF" />
                <ComboBox x:Name="GifQualityCombo">
                  <ComboBoxItem Content="Compacte · 8 images/s · 720 px max." Tag="Compact" />
                  <ComboBoxItem Content="Équilibrée · 10 images/s · 960 px max." Tag="Balanced" />
                  <ComboBoxItem Content="Haute · 12 images/s · 1280 px max." Tag="High" />
                </ComboBox>
              </StackPanel>
            </TabItem>
            <TabItem Header="Audio" FontSize="14" Foreground="#B4C0BD">
              <StackPanel Margin="0,8,0,0" Spacing="8">
                <TextBlock Text="ENCODAGE AUDIO SEUL · SANS IMAGE" FontSize="9" FontWeight="Bold" Foreground="#C58CFF" />
                <ComboBox x:Name="AudioOnlyEncodingQualityCombo">
                  <ComboBoxItem Content="96 kb/s · mono" Tag="Compact" />
                  <ComboBoxItem Content="128 kb/s · stéréo" Tag="Balanced" />
                  <ComboBoxItem Content="192 kb/s · stéréo" Tag="High" />
                </ComboBox>
                <WrapPanel>
                  <CheckBox x:Name="AudioOnlySystemCheck" Content="Enregistrer le son du système" Margin="0,0,16,0" />
                  <CheckBox x:Name="AudioOnlyMicrophoneCheck" Content="Enregistrer le microphone" />
                </WrapPanel>
              </StackPanel>
            </TabItem>
          </TabControl>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Text="SÉLECTION · IMAGE / VIDÉO / GIF" FontSize="9" FontWeight="Bold" Foreground="#90A09E" VerticalAlignment="Center" />
            <ComboBox x:Name="SelectionModeCombo" Grid.Column="1">
              <ComboBoxItem Content="Intelligente" Tag="Smart" />
              <ComboBoxItem Content="Fenêtre" Tag="Window" />
              <ComboBoxItem Content="Écran" Tag="Screen" />
              <ComboBoxItem Content="Zone libre" Tag="Region" />
            </ComboBox>
          </Grid>
        </StackPanel>
      </Border>

      <Border x:Name="PluginOptionsBorder" Grid.Row="3" IsVisible="False" Padding="11" CornerRadius="11"
              Background="#101717" BorderBrush="#3B493C" BorderThickness="1">
        <StackPanel Spacing="7">
          <TextBlock Text="POST-TRAITEMENTS" FontSize="9" FontWeight="Bold" Foreground="#9BFF28" LetterSpacing="1" />
          <WrapPanel x:Name="PluginOptionsPanel" Orientation="Horizontal" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
  <Window.Styles>
    <Style Selector="Button.capture-mode">
      <Setter Property="Background" Value="#151C1C" />
      <Setter Property="BorderBrush" Value="#253030" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.capture-mode:pointerover">
      <Setter Property="Background" Value="#202B27" />
      <Setter Property="BorderBrush" Value="#9BFF28" />
    </Style>
  </Window.Styles>
</Window>
