<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CyCapture.Views.GalleryWindow"
        Title="CyCapture · Galerie"
        Width="920" Height="680"
        MinWidth="720" MinHeight="500"
        CanResize="True"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="26" RowDefinitions="Auto,Auto,*" RowSpacing="18">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
      <Border Width="42" Height="42" CornerRadius="21" Background="#17201D" BorderBrush="#9BFF28" BorderThickness="2">
        <Ellipse Width="12" Height="12" Fill="#9BFF28" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="Galerie CyCapture" FontSize="22" FontWeight="Black" />
        <TextBlock x:Name="GalleryStatusText" Text="CHARGEMENT DES CAPTURES…" FontSize="10" Foreground="#8E9C99" LetterSpacing="1.1" />
      </StackPanel>
      <Button Grid.Column="2" Content="Actualiser" Click="RefreshClick" Padding="18,9" VerticalAlignment="Center" />
    </Grid>

    <Border Grid.Row="1" Padding="12" CornerRadius="10" Background="#111817" BorderBrush="#263331" BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock x:Name="OutputPathText" VerticalAlignment="Center" Foreground="#AAB7B4" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1" Content="Ouvrir le dossier" Click="OpenFolderClick" />
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <WrapPanel x:Name="GalleryPanel" Orientation="Horizontal" />
      </ScrollViewer>
      <Border x:Name="EmptyGalleryPanel" IsVisible="False" Padding="30" CornerRadius="14"
              Background="#111817" BorderBrush="#263331" BorderThickness="1"
              HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <TextBlock Text="Aucune capture" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
          <TextBlock Text="Vos prochaines images, vidéos, GIF et captures audio apparaîtront ici." Foreground="#8E9C99" TextAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
