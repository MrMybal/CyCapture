<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CyCapture.Views.SettingsWindow"
        Title="CyCapture"
        Width="680" Height="760"
        MinWidth="560" MinHeight="620"
        CanResize="True"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer>
    <StackPanel Margin="28" Spacing="20">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Border Width="42" Height="42" CornerRadius="21" Background="#17201D" BorderBrush="#9BFF28" BorderThickness="2">
          <Ellipse Width="12" Height="12" Fill="#9BFF28" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="CyCapture" FontSize="22" FontWeight="Black" />
          <TextBlock Text="ACTIF EN ARRIÈRE-PLAN · AVALONIA/C#" FontSize="10" Foreground="#8E9C99" LetterSpacing="1.2" />
        </StackPanel>
      </Grid>

      <Border Padding="16" CornerRadius="12" Background="#111817" BorderBrush="#263331" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="CAPTURE RAPIDE" FontSize="10" FontWeight="Bold" Foreground="#9BFF28" LetterSpacing="1.4" />
          <TextBlock Text="Lancez immédiatement un mode ici. Pendant une vidéo, un GIF ou un audio, Impr écran arrête l’enregistrement." TextWrapping="Wrap" Foreground="#B4C0BD" />
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
            <Button Grid.Column="0" Content="▣  Image" Click="ImageClick" Height="42" />
            <Button Grid.Column="1" Content="●  Vidéo" Click="VideoClick" Height="42" />
            <Button Grid.Column="2" Content="GIF" Click="GifClick" Height="42" />
            <Button Grid.Column="3" Content="♪  Audio" Click="AudioClick" Height="42" />
          </Grid>
        </StackPanel>
      </Border>

      <StackPanel Spacing="8">
        <TextBlock Text="COMPORTEMENT DE LA TOUCHE IMPR ÉCRAN" FontSize="10" FontWeight="Bold" Foreground="#9BFF28" LetterSpacing="1.4" />
        <ComboBox x:Name="PrintScreenBehaviorCombo" SelectionChanged="SelectionPreferenceChanged">
          <ComboBoxItem Content="Afficher le choix Image / Vidéo / GIF / Audio" Tag="ShowModePicker" />
          <ComboBoxItem Content="Capture d’image directe" Tag="CaptureImage" />
          <ComboBoxItem Content="Capture vidéo directe" Tag="CaptureVideo" />
          <ComboBoxItem Content="Capture GIF directe" Tag="CaptureGif" />
          <ComboBoxItem Content="Capture audio directe" Tag="CaptureAudio" />
          <ComboBoxItem Content="Appui court : sélection image · maintien réglable : modes" Tag="QuickImageHoldSelection" />
        </ComboBox>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <TextBlock Text="Délai du maintien" VerticalAlignment="Center" Foreground="#B4C0BD" />
          <ComboBox x:Name="PrintScreenHoldDelayCombo" Grid.Column="1" Width="130" HorizontalAlignment="Left" SelectionChanged="SelectionPreferenceChanged">
            <ComboBoxItem Content="0,1 seconde" Tag="100" />
            <ComboBoxItem Content="0,2 seconde" Tag="200" />
            <ComboBoxItem Content="0,3 seconde" Tag="300" />
            <ComboBoxItem Content="0,4 seconde" Tag="400" />
            <ComboBoxItem Content="0,5 seconde" Tag="500" />
            <ComboBoxItem Content="0,6 seconde" Tag="600" />
            <ComboBoxItem Content="0,7 seconde" Tag="700" />
            <ComboBoxItem Content="0,8 seconde" Tag="800" />
            <ComboBoxItem Content="0,9 seconde" Tag="900" />
            <ComboBoxItem Content="1 seconde" Tag="1000" />
          </ComboBox>
        </Grid>
        <TextBlock Text="Les modes directs sautent la palette. Dans le mode hybride, un appui court ouvre la sélection intelligente d’image ; un maintien pendant le délai choisi ouvre la palette Image / Vidéo / GIF / Audio." TextWrapping="Wrap" Foreground="#7F8D8A" FontSize="11" />
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="DOSSIER DES CAPTURES" FontSize="10" FontWeight="Bold" Foreground="#9BFF28" LetterSpacing="1.4" />
        <Border Padding="12" CornerRadius="10" Background="#111817" BorderBrush="#263331" BorderThickness="1">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock x:Name="OutputPathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="Choisir" Click="ChooseFolderClick" />
            <Button Grid.Column="2" Content="Ouvrir" Click="OpenFolderClick" />
          </Grid>
        </Border>
        <Border Padding="12" CornerRadius="10" Background="#111817" BorderBrush="#263331" BorderThickness="1">
          <StackPanel Spacing="10">
            <CheckBox x:Name="SeparateCaptureTypesCheck"
                      Content="Séparer les captures par type (Images, Videos, GIFs et Audio)"
                      IsCheckedChanged="CheckedPreferenceChanged" />
            <CheckBox x:Name="DailyFoldersCheck"
                      Content="Créer automatiquement un sous-dossier par jour"
                      IsCheckedChanged="CheckedPreferenceChanged" />
            <TextBlock x:Name="CaptureOrganizationPreview"
                       TextWrapping="Wrap"
                       Foreground="#7F8D8A"
                       FontSize="11" />
          </StackPanel>
        </Border>
      </StackPanel>

      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
        <StackPanel Spacing="6">
          <TextBlock Text="FLUIDITÉ VIDÉO" FontSize="10" FontWeight="Bold" Foreground="#FF6573" LetterSpacing="1.1" />
          <ComboBox x:Name="VideoQualityCombo" SelectionChanged="SelectionPreferenceChanged">
            <ComboBoxItem Content="24 images/s" Tag="Compact" />
            <ComboBoxItem Content="30 images/s" Tag="Balanced" />
            <ComboBoxItem Content="60 images/s" Tag="High" />
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock Text="QUALITÉ GIF" FontSize="10" FontWeight="Bold" Foreground="#6CE5FF" LetterSpacing="1.1" />
          <ComboBox x:Name="GifQualityCombo" SelectionChanged="SelectionPreferenceChanged">
            <ComboBoxItem Content="Compacte · 8 i/s" Tag="Compact" />
            <ComboBoxItem Content="Équilibrée · 10 i/s" Tag="Balanced" />
            <ComboBoxItem Content="Haute · 12 i/s" Tag="High" />
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="6">
          <TextBlock Text="SÉLECTION PAR DÉFAUT" FontSize="10" FontWeight="Bold" Foreground="#9BFF28" LetterSpacing="1.1" />
          <ComboBox x:Name="SelectionModeCombo" SelectionChanged="SelectionPreferenceChanged">
            <ComboBoxItem Content="Intelligente" Tag="Smart" />
            <ComboBoxItem Content="Fenêtre" Tag="Window" />
            <ComboBoxItem Content="Écran" Tag="Screen" />
            <ComboBoxItem Content="Zone libre" Tag="Region" />
          </ComboBox>
        </StackPanel>
      </Grid>

      <Border Padding="14" CornerRadius="12" Background="#111817" BorderBrush="#263331" BorderThickness="1">
        <StackPanel Spacing="12">
          <StackPanel Spacing="3">
            <TextBlock Text="ENCODAGE ET TAILLE DES FICHIERS" FontSize="10" FontWeight="Bold" Foreground="#9BFF28" LetterSpacing="1.4" />
            <TextBlock Text="Ces profils sont indépendants du nombre d’images par seconde." Foreground="#7F8D8A" FontSize="11" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
            <StackPanel Spacing="5">
              <TextBlock Text="FORMAT IMAGE" FontSize="9" FontWeight="Bold" Foreground="#B4C0BD" />
              <ComboBox x:Name="ImageFormatCombo" SelectionChanged="SelectionPreferenceChanged">
                <ComboBoxItem Content="PNG · sans perte" Tag="png" />
                <ComboBoxItem Content="JPEG · fichier réduit" Tag="jpeg" />
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Text="QUALITÉ JPEG" FontSize="9" FontWeight="Bold" Foreground="#B4C0BD" />
              <ComboBox x:Name="ImageEncodingQualityCombo" SelectionChanged="SelectionPreferenceChanged">
                <ComboBoxItem Content="Compacte · 40 %" Tag="Compact" />
                <ComboBoxItem Content="Équilibrée · 70 %" Tag="Balanced" />
                <ComboBoxItem Content="Haute · 90 %" Tag="High" />
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="5">
              <TextBlock Text="DÉBIT VIDÉO H.264" FontSize="9" FontWeight="Bold" Foreground="#FF6573" />
              <ComboBox x:Name="VideoEncodingQualityCombo" SelectionChanged="SelectionPreferenceChanged">
                <ComboBoxItem Content="Très faible · 1 Mbit/s" Tag="VeryLow" />
                <ComboBoxItem Content="Compact · 2,5 Mbit/s" Tag="Compact" />
                <ComboBoxItem Content="Équilibré · 6 Mbit/s" Tag="Balanced" />
                <ComboBoxItem Content="Haute qualité · 12 Mbit/s" Tag="High" />
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
              <TextBlock Text="ENCODAGE AUDIO" FontSize="9" FontWeight="Bold" Foreground="#6CE5FF" />
              <ComboBox x:Name="AudioEncodingQualityCombo" SelectionChanged="SelectionPreferenceChanged">
                <ComboBoxItem Content="Compact · 96 kbit/s mono" Tag="Compact" />
                <ComboBoxItem Content="Équilibré · 128 kbit/s stéréo" Tag="Balanced" />
                <ComboBoxItem Content="Haute qualité · 192 kbit/s stéréo" Tag="High" />
              </ComboBox>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Padding="14" CornerRadius="12" Background="#111817" BorderBrush="#263331" BorderThickness="1">
        <StackPanel Spacing="13">
          <CheckBox x:Name="SystemAudioCheck" Content="Capturer le son du système" IsCheckedChanged="CheckedPreferenceChanged" />
          <CheckBox x:Name="MicrophoneCheck" Content="Ajouter le microphone" IsCheckedChanged="CheckedPreferenceChanged" />
          <CheckBox x:Name="ClipboardCheck" Content="Copier les images dans le presse-papiers" IsCheckedChanged="CheckedPreferenceChanged" />
          <CheckBox x:Name="VideoClipboardCheck" Content="Copier les vidéos dans le presse-papiers comme fichiers" IsCheckedChanged="CheckedPreferenceChanged" />
          <CheckBox x:Name="QuickAnnotationsCheck" Content="Afficher les outils d’annotation rapide pendant la sélection d’image" IsCheckedChanged="CheckedPreferenceChanged" />
          <TextBlock Text="Après la sélection, dessinez, ajoutez un cadre, une flèche ou du texte sur l’image figée avant de la capturer."
                     Margin="28,-8,0,0" TextWrapping="Wrap" Foreground="#7F8D8A" FontSize="11" />
          <CheckBox x:Name="FrameCheck" Content="Afficher le cadre rouge hors de la zone enregistrée" IsCheckedChanged="CheckedPreferenceChanged" />
          <CheckBox x:Name="StartupCheck" Content="Lancer CyCapture au démarrage de Windows" IsCheckedChanged="CheckedPreferenceChanged" />
          <TextBlock x:Name="StartupStatusText"
                     Text="CyCapture démarrera directement dans la zone de notification pour l’utilisateur actuel."
                     TextWrapping="Wrap"
                     Foreground="#7F8D8A"
                     FontSize="11" />
        </StackPanel>
      </Border>

      <Border Padding="14" CornerRadius="12" Background="#111817" BorderBrush="#263331" BorderThickness="1">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel>
              <TextBlock Text="PLUGINS DE POST-TRAITEMENT" FontSize="10" FontWeight="Bold" Foreground="#9BFF28" LetterSpacing="1.4" />
              <TextBlock Text="Activez et configurez chaque extension indépendamment." Foreground="#7F8D8A" FontSize="11" />
            </StackPanel>
            <Button Grid.Column="1" Content="Dossier des plugins" Click="OpenPluginsFolderClick" />
          </Grid>
          <StackPanel x:Name="PluginsPanel" Spacing="10" />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="Fermer cette fenêtre laisse CyCapture dans la zone de notification." Foreground="#7F8D8A" FontSize="11" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Fermer" Click="CloseClick" Padding="22,9" />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Window>
