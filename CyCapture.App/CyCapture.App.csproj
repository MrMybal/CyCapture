<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\CyCapture.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <UseWPF>true</UseWPF>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>CyCapture</AssemblyName>
    <RootNamespace>CyCapture</RootNamespace>
    <Version>1.4.3</Version>
    <Authors>CyberAlien</Authors>
    <Copyright>Copyright © 2026 CyberAlien</Copyright>
    <Product>CyCapture</Product>
    <Description>Outil de capture discret pour Windows, construit avec Avalonia et C#.</Description>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/MrMybal/CyCapture</RepositoryUrl>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <CyAnnotaBundleVersion>0.3.7</CyAnnotaBundleVersion>
    <CyAnnotaBundleFileName>CyAnnota-$(CyAnnotaBundleVersion)-portable.exe</CyAnnotaBundleFileName>
    <CyAnnotaBundleUrl>https://github.com/MrMybal/CyAnnota/releases/download/v$(CyAnnotaBundleVersion)/$(CyAnnotaBundleFileName)</CyAnnotaBundleUrl>
    <CyAnnotaBundleSha256>A07452E00BB463B63D6ED68092A3119033471A7B04A808D00ECD9B493FC93C02</CyAnnotaBundleSha256>
    <CyAnnotaBundleCacheDirectory>$(BaseIntermediateOutputPath)cyannota</CyAnnotaBundleCacheDirectory>
    <CyAnnotaBundlePath>$(CyAnnotaBundleCacheDirectory)\$(CyAnnotaBundleFileName)</CyAnnotaBundlePath>
    <CyAnnotaUnpackedArchiveFileName>CyAnnota-$(CyAnnotaBundleVersion)-win-x64.zip</CyAnnotaUnpackedArchiveFileName>
    <CyAnnotaUnpackedArchivePath>$(CyAnnotaBundleCacheDirectory)\$(CyAnnotaUnpackedArchiveFileName)</CyAnnotaUnpackedArchivePath>
    <BundleCyAnnota Condition="'$(BundleCyAnnota)' == '' and '$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64'">true</BundleCyAnnota>
    <BundleCyAnnota Condition="'$(BundleCyAnnota)' == ''">false</BundleCyAnnota>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.20" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\BUNDLED_COMPONENTS.md" Link="BUNDLED_COMPONENTS.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <EmbeddedResource Include="$(CyAnnotaBundlePath)" LogicalName="CyCapture.Bundled.$(CyAnnotaBundleFileName)"
                      Condition="'$(BundleCyAnnota)' == 'true' and '$(CyAnnotaUnpackedDirectory)' == ''" />
    <EmbeddedResource Include="$(CyAnnotaUnpackedArchivePath)" LogicalName="CyCapture.Bundled.$(CyAnnotaUnpackedArchiveFileName)"
                      Condition="'$(BundleCyAnnota)' == 'true' and '$(CyAnnotaUnpackedDirectory)' != ''" />
  </ItemGroup>

  <Target Name="PrepareBundledCyAnnota" BeforeTargets="PrepareResourceNames" Condition="'$(BundleCyAnnota)' == 'true'">
    <MakeDir Directories="$(CyAnnotaBundleCacheDirectory)" />
    <Error Condition="'$(CyAnnotaUnpackedDirectory)' != '' and !Exists('$(CyAnnotaUnpackedDirectory)\CyAnnota.exe')"
           Text="Le dossier CyAnnota unpacked ne contient pas CyAnnota.exe." />
    <ZipDirectory SourceDirectory="$(CyAnnotaUnpackedDirectory)" DestinationFile="$(CyAnnotaUnpackedArchivePath)" Overwrite="true"
                  Condition="'$(CyAnnotaUnpackedDirectory)' != '' and !Exists('$(CyAnnotaUnpackedArchivePath)')" />
    <Copy SourceFiles="$(CyAnnotaBundleSource)" DestinationFiles="$(CyAnnotaBundlePath)" SkipUnchangedFiles="true"
          Condition="'$(CyAnnotaUnpackedDirectory)' == '' and '$(CyAnnotaBundleSource)' != ''" />
    <DownloadFile SourceUrl="$(CyAnnotaBundleUrl)" DestinationFolder="$(CyAnnotaBundleCacheDirectory)"
                  DestinationFileName="$(CyAnnotaBundleFileName)" SkipUnchangedFiles="true"
                  Condition="'$(CyAnnotaUnpackedDirectory)' == '' and '$(CyAnnotaBundleSource)' == '' and !Exists('$(CyAnnotaBundlePath)')" />
    <GetFileHash Files="$(CyAnnotaBundlePath)" Algorithm="SHA256" Condition="'$(CyAnnotaUnpackedDirectory)' == ''">
      <Output TaskParameter="Items" ItemName="CyAnnotaBundleHashItem" />
    </GetFileHash>
    <Error Condition="'$(CyAnnotaUnpackedDirectory)' == '' and '%(CyAnnotaBundleHashItem.FileHash)' != '$(CyAnnotaBundleSha256)'"
           Text="L'empreinte SHA-256 de CyAnnota ne correspond pas à la version officielle attendue." />
    <Message Importance="high" Text="CyAnnota $(CyAnnotaBundleVersion) unpacked est intégré depuis $(CyAnnotaUnpackedDirectory)."
             Condition="'$(CyAnnotaUnpackedDirectory)' != ''" />
    <Message Importance="high" Text="CyAnnota $(CyAnnotaBundleVersion) portable est intégré depuis $(CyAnnotaBundlePath)."
             Condition="'$(CyAnnotaUnpackedDirectory)' == ''" />
  </Target>

  <Target Name="RemovePublishedDebugSymbols" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <PublishedDebugSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishedDebugSymbols)" />
  </Target>
</Project>
