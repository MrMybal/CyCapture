<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CyCapture.Plugin.CyAnnota</AssemblyName>
    <RootNamespace>CyCapture.Plugins</RootNamespace>
    <Version>0.3.9</Version>
    <Authors>CyberAlien</Authors>
    <Description>Plugin de post-édition CyAnnota pour CyCapture.</Description>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/MrMybal/CyCapture</RepositoryUrl>
    <CyAnnotaBundleVersion>0.3.9</CyAnnotaBundleVersion>
    <CyAnnotaBundleFileName>CyAnnota-$(CyAnnotaBundleVersion)-portable.exe</CyAnnotaBundleFileName>
    <CyAnnotaBundleUrl>https://github.com/MrMybal/CyAnnota/releases/download/v$(CyAnnotaBundleVersion)/$(CyAnnotaBundleFileName)</CyAnnotaBundleUrl>
    <CyAnnotaBundleSha256>0EE600E3554C0B3DE3187172A90FBEE63F47AF99B6DD20C0436D1734EFF3D59F</CyAnnotaBundleSha256>
    <CyAnnotaBundleCacheDirectory>$(BaseIntermediateOutputPath)cyannota</CyAnnotaBundleCacheDirectory>
    <CyAnnotaBundlePath>$(CyAnnotaBundleCacheDirectory)\$(CyAnnotaBundleFileName)</CyAnnotaBundlePath>
    <BundleCyAnnota Condition="'$(BundleCyAnnota)' == '' and '$(Configuration)' == 'Release'">true</BundleCyAnnota>
    <BundleCyAnnota Condition="'$(BundleCyAnnota)' == ''">false</BundleCyAnnota>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CyCapture.App\CyCapture.App.csproj"
                      AdditionalProperties="IncludeCyAnnotaPlugin=false;BundleCyAnnota=false"
                      Private="false" />
    <Compile Include="..\CyCapture.App\Plugins\CyAnnotaPostProcessor.cs" Link="CyAnnotaPostProcessor.cs" />
    <EmbeddedResource Include="$(CyAnnotaBundlePath)" LogicalName="CyCapture.Bundled.$(CyAnnotaBundleFileName)"
                      Condition="'$(BundleCyAnnota)' == 'true'" />
  </ItemGroup>

  <Target Name="PrepareBundledCyAnnota" BeforeTargets="PrepareResourceNames" Condition="'$(BundleCyAnnota)' == 'true'">
    <MakeDir Directories="$(CyAnnotaBundleCacheDirectory)" />
    <Copy SourceFiles="$(CyAnnotaBundleSource)" DestinationFiles="$(CyAnnotaBundlePath)" SkipUnchangedFiles="true"
          Condition="'$(CyAnnotaBundleSource)' != ''" />
    <DownloadFile SourceUrl="$(CyAnnotaBundleUrl)" DestinationFolder="$(CyAnnotaBundleCacheDirectory)"
                  DestinationFileName="$(CyAnnotaBundleFileName)" SkipUnchangedFiles="true"
                  Condition="'$(CyAnnotaBundleSource)' == '' and !Exists('$(CyAnnotaBundlePath)')" />
    <GetFileHash Files="$(CyAnnotaBundlePath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="CyAnnotaBundleHashItem" />
    </GetFileHash>
    <Error Condition="'%(CyAnnotaBundleHashItem.FileHash)' != '$(CyAnnotaBundleSha256)'"
           Text="L'empreinte SHA-256 de CyAnnota ne correspond pas à la version officielle attendue." />
    <Message Importance="high" Text="Le plugin CyCapture inclut CyAnnota $(CyAnnotaBundleVersion) depuis $(CyAnnotaBundlePath)." />
  </Target>
</Project>
